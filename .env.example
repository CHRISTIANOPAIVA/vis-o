# Chave da API da Anthropic, usada em /api/analyze-food para a analise nutricional das fotos
ANTHROPIC_API_KEY=

# Codigo de acesso pedido uma vez por aparelho antes de usar /api/analyze-food. Vazio = sem codigo (qualquer um com a URL gasta seus creditos)
APP_CODE=

# Modelo Anthropic usado na analise (ex.: claude-haiku-4-5)
ANTHROPIC_MODEL=

# URL do projeto Supabase usado como banco de dados
SUPABASE_URL=

# Chave service-role do Supabase (acesso total, usar SOMENTE no servidor, nunca expor no client)
SUPABASE_SERVICE_ROLE_KEY=

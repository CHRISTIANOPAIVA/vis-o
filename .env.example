# Chave da API da Anthropic, usada em /api/analyze-food para a analise nutricional das fotos
ANTHROPIC_API_KEY=

# Modelo Anthropic usado na analise (ex.: claude-haiku-4-5)
ANTHROPIC_MODEL=

# URL do projeto Supabase usado como banco de dados
SUPABASE_URL=

# Chave service-role do Supabase (acesso total, usar SOMENTE no servidor, nunca expor no client)
SUPABASE_SERVICE_ROLE_KEY=

# Segredo usado para assinar/verificar o cookie de sessao do login (HMAC-SHA256). Gere um valor forte com: openssl rand -base64 32
AUTH_SECRET=

# Senha unica para entrar no app (dono do app). Use um valor forte e nao reutilizado em outro servico.
APP_PASSWORD=
